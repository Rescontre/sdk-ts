{
  "name": "rescontre",
  "version": "0.1.0",
  "description": "SDK for Rescontre agent payment ops: event ingestion, receipt timelines, and issue detection for agent/API payment traffic.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && tsc -p tsconfig.build.json",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rescontre/sdk-ts.git"
  },
  "keywords": [
    "x402",
    "clearinghouse",
    "netting",
    "agent-payments",
    "rescontre"
  ],
  "author": "Joanne Lim",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rescontre/sdk-ts/issues"
  },
  "homepage": "https://github.com/Rescontre/sdk-ts#readme",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
